# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/routine

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# JWT Secret (use strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# CORS Origin (frontend URL)
CORS_ORIGIN=http://localhost:3000

# ============================================================================
# RATE LIMITING
# ============================================================================

# Rate limiting window in milliseconds (default: 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window (default: 100)
RATE_LIMIT_MAX=100

# ============================================================================
# AI INSIGHTS CONFIGURATION
# ============================================================================

# AI Service Backend: LOCAL | OPENAI | HUGGINGFACE
# LOCAL: Rule-based analysis (free, no API keys needed) - DEFAULT
# OPENAI: GPT-3.5-turbo (requires free API credits)
# HUGGINGFACE: Open-source models (free tier available)
AI_SERVICE=LOCAL

# ============================================================================
# OPENAI CONFIGURATION (Optional - if using OpenAI backend)
# ============================================================================

# Get your API key from: https://platform.openai.com/account/api-keys
# OPENAI_API_KEY=sk-your-key-here

# OpenAI Model (default: gpt-3.5-turbo)
# OPENAI_MODEL=gpt-3.5-turbo

# Temperature (0-2): Lower = more deterministic, Higher = more creative
# OPENAI_TEMPERATURE=0.7

# Max tokens per response
# OPENAI_MAX_TOKENS=800

# ============================================================================
# HUGGING FACE CONFIGURATION (Optional - if using Hugging Face backend)
# ============================================================================

# Get your API token from: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=hf_your-token-here

# Model ID for text generation
# HUGGINGFACE_MODEL=distilgpt2

# ============================================================================
# INSIGHTS RATE LIMITING
# ============================================================================

# Requests per hour for insights endpoints
INSIGHTS_RATE_LIMIT_HOUR=50

# Requests per day for insights endpoints
INSIGHTS_RATE_LIMIT_DAY=500

# ============================================================================
# INSIGHTS CACHING
# ============================================================================

# Cache TTL in milliseconds (default: 1 hour = 3600000)
INSIGHTS_CACHE_TTL=3600000

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log directory
LOG_DIR=./logs

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable AI insights feature
ENABLE_INSIGHTS=true

# Enable email notifications
ENABLE_EMAIL_NOTIFICATIONS=false

# Enable data export
ENABLE_DATA_EXPORT=true

# ============================================================================
# PRODUCTION SETUP CHECKLIST
# ============================================================================

# Before deploying to production:
# 1. [ ] Change NODE_ENV to 'production'
# 2. [ ] Generate strong JWT_SECRET (min 32 characters)
# 3. [ ] Update MONGODB_URI to production database
# 4. [ ] Update CORS_ORIGIN to production frontend URL
# 5. [ ] Choose AI_SERVICE backend (recommend: LOCAL for speed)
# 6. [ ] If using OpenAI: Add OPENAI_API_KEY and set limits
# 7. [ ] If using HF: Add HUGGINGFACE_API_KEY
# 8. [ ] Set appropriate rate limiting
# 9. [ ] Configure logging appropriately
# 10. [ ] Test all endpoints before deployment
# 11. [ ] Set up monitoring and alerting
# 12. [ ] Document backend choice for team

# ============================================================================
# QUICK START GUIDE
# ============================================================================

# Development (default settings - works out of box):
# 1. Copy this file to .env
# 2. Install dependencies: npm install
# 3. Start MongoDB: mongod (or MongoDB Atlas)
# 4. Run server: npm run dev
# 5. Test: curl http://localhost:5000/health

# With OpenAI:
# 1. Get API key from https://platform.openai.com/account/api-keys
# 2. Set: OPENAI_API_KEY=sk-...
# 3. Set: AI_SERVICE=OPENAI
# 4. npm install openai
# 5. Restart server

# With Hugging Face:
# 1. Get token from https://huggingface.co/settings/tokens
# 2. Set: HUGGINGFACE_API_KEY=hf_...
# 3. Set: AI_SERVICE=HUGGINGFACE
# 4. Restart server
